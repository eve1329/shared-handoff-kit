{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON_COMMAND__ /__SHARED_HANDOFF_KIT__/hooks/session_start.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON_COMMAND__ /__SHARED_HANDOFF_KIT__/hooks/task_context.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON_COMMAND__ /__SHARED_HANDOFF_KIT__/hooks/context_handoff.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
